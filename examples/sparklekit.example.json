{
  "$schema": "https://leontofficial.github.io/SparkleReleaseKit/schema/sparklekit.schema.json",
  "app": {
    "bundleIdentifier": "com.example.MyApp",
    "minimumMacOS": "13.0",
    "name": "My App",
    "sandboxed": false,
    "style": "swiftUI"
  },
  "distribution": {
    "allowAdHocSigning": true,
    "expectedArchitectures": [
      "arm64",
      "x86_64"
    ],
    "installer": "dmg",
    "releaseMode": "free",
    "requireDeveloperID": false,
    "requireNotarization": false,
    "requireSparkleSignature": true,
    "updateArchive": "zip"
  },
  "github": {
    "owner": "ExampleDeveloper",
    "pagesBranch": "gh-pages",
    "repository": "MyApp"
  },
  "project": {
    "configuration": "Release",
    "container": "My App.xcodeproj",
    "generateWorkflow": true,
    "infoPlist": "My App/Info.plist",
    "scheme": "My App",
    "target": "My App",
    "template": "auto"
  },
  "schemaVersion": 4,
  "tools": {
    "generateAppcast": {
      "allowEnvironmentOverrideInCI": false,
      "allowedSHA256": [],
      "designatedRequirement": null,
      "expectedSigningIdentifier": null,
      "expectedTeamIdentifier": null,
      "requireValidSignature": true
    }
  },
  "management": {
    "generatedByVersion": "0.4.0",
    "knownTemplateVersion": 1,
    "lastAppliedMigration": "schema-4-managed-files",
    "managedFiles": []
  },
  "updates": {
    "automaticChecks": true,
    "automaticDownloads": false,
    "channel": null,
    "feedURL": "https://exampledeveloper.github.io/MyApp/appcast.xml",
    "publicEDKey": "",
    "sparkleVersion": "2.9.4"
  }
}
